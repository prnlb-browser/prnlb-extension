{
  "manifest_version": 3,
  "name": "PRNLB Viewer",
  "version": "2.0.0",
  "description": "View screenshots from Pornolab topic pages in a carousel.",
  "browser_specific_settings": {
    "gecko": {
      "id": "prnlb-viewer@example.com",
      "strict_min_version": "120.0"
    }
  },
  "permissions": ["activeTab", "tabs", "scripting", "windows", "storage"],
  "host_permissions": [
    "https://pornolab.net/*",
    "*://*.fastpic.org/*",
    "*://fastpic.org/*",
    "https://*.imgbox.com/*",
    "https://imgbox.com/*",
    "https://*.turboimagehost.com/*",
    "https://turboimagehost.com/*",
    "https://www.boobpedia.com/*",
    "https://www.iafd.com/*"
  ],
  "action": {
    "default_title": "PRNLB Viewer: enabled (click to disable)",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["https://pornolab.net/*"]
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pornolab.net/forum/viewtopic.php*",
        "https://pornolab.net/forum/viewforum.php*",
        "https://pornolab.net/forum/tracker.php*"
      ],
      "js": ["content.js"]
    }
  ]
}
